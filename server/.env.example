# Copia estos valores a las variables de entorno del servidor (Render).
LIVEKIT_URL=wss://tu-proyecto.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Base de datos (Neon, Postgres): iglesias, claves, salas y minutos.
DATABASE_URL=postgres://usuario:clave@host/base?sslmode=require
PORT=8080
# La contraseña del panel y el SMTP se configuran dentro del propio panel.
# Correo por Gmail API (vía principal; Render gratis bloquea SMTP):
# cliente OAuth de Google Cloud con redirect
# https://panel.movilizar.me/api/admin/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
PUBLIC_URL=https://panel.movilizar.me
